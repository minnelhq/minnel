{
  "extraKnownMarketplaces": {
    "minnel": {
      "source": {
        "source": "github",
        "repo": "tcrossland/claude-code-methodology"
      }
    }
  },
  "enabledPlugins": {
    "minnel@minnel": true
  },
  "permissions": {
    "allow": [
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/docs-consistency.sh"
          }
        ]
      }
    ]
  }
}
